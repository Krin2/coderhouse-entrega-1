# Copiá este archivo a .env y completá tus claves. NO subas .env al repositorio.

# Proveedor a usar: "openai" o "anthropic"
LLM_PROVIDER=openai

# Claves de API (solo hace falta la del proveedor elegido)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Modelos
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
